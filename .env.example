# ==============================================================================
# Moodly 환경 설정 예시 파일 (.env.example)
# ==============================================================================
# 이 파일은 환경 설정의 규격과 변수명을 공유하기 위한 예시 템플릿입니다.
# 실제 비밀키는 여기에 적지 마시고, 복사하여 .env 파일에 입력해 주세요.
# ==============================================================================

# OpenAI API 비밀키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 사용할 OpenAI 모델명 (기본 권장: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Supabase 프로젝트 URL (https://supabase.com -> Project Settings -> API)
SUPABASE_URL=

# Supabase 서비스 롤 키 (서버 전용 비밀키, Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

